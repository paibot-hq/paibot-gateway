{
  "listen": ":8080",
  "upstreams": {
    "ollama": { "base_url": "http://host.docker.internal:11434/v1", "timeout_seconds": 300 }
  },
  "models": {
    "chat": { "targets": [{ "upstream": "ollama", "model": "qwen3:0.6b" }] }
  },
  "database_url_env": "PAIBOT_GATEWAY_DATABASE_URL",
  "admin_token_env": "PAIBOT_GATEWAY_ADMIN_TOKEN",
  "admin_listen": ":8081",
  "timezone": "UTC"
}
